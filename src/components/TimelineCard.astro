---
interface Props {
  date: string;
  title: string;
  excerpt: string;
  tag: string;
  href: string;
}

import Icon from "./Icon.astro";

const { date, title, excerpt, tag, href } = Astro.props;
---

<article class="group grid gap-5 border-t border-ink/15 py-8 sm:grid-cols-[150px_1fr_auto] sm:items-start">
  <div>
    <time class="text-xs font-semibold tracking-[0.12em] text-sea">{date}</time>
    <p class="mt-2 text-[10px] uppercase tracking-[0.16em] text-ink/35">{tag}</p>
  </div>
  <div class="max-w-2xl">
    <h3 class="text-xl font-semibold tracking-[-0.02em] transition-colors group-hover:text-sea sm:text-2xl">{title}</h3>
    <p class="mt-3 text-sm leading-7 text-ink/55">{excerpt}</p>
  </div>
  <a href={href} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full border border-transparent py-2 text-xs font-semibold sm:justify-self-end">
    阅读全文 <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </a>
</article>
