---
import { siteConfig } from "../config/site";
---

<footer id="footer" data-section data-nav-tone="dark" class="bg-obsidian pb-28 pt-16 text-white sm:pb-24">
  <div class="section-shell grid gap-10 sm:grid-cols-2 sm:items-end">
    <div>
      <p class="font-display text-[clamp(3rem,9vw,8rem)] leading-none tracking-[0.01em]">TOOONRAN</p>
      <p class="mt-4 text-xs tracking-[0.12em] text-white/35">PERSONAL SIGNAL, ALWAYS IN PROGRESS.</p>
    </div>
    <div class="sm:text-right">
      <a href={`mailto:${siteConfig.contactEmail}`} class="text-sm text-white/65 transition-colors hover:text-coral">{siteConfig.contactEmail}</a>
      <p class="mt-4 text-[11px] text-white/30">© {new Date().getFullYear()} {siteConfig.brand}. Built with Astro.</p>
    </div>
  </div>
</footer>
