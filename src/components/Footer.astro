---
import { siteConfig } from "../config/site";
---

<footer id="footer" data-section data-nav-tone="dark" class="bg-obsidian pb-14 pt-12 text-white">
  <div class="section-shell">
    <p class="font-display text-[clamp(3rem,9vw,8rem)] leading-none tracking-[0.01em]">TOOONRAN</p>
    <div class="mt-5 flex flex-col gap-4 border-t border-white/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs tracking-[0.12em] text-white/35">PERSONAL SIGNAL, ALWAYS IN PROGRESS.</p>
      <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-6">
        <a href={`mailto:${siteConfig.contactEmail}`} class="text-sm text-white/65 transition-colors hover:text-coral">{siteConfig.contactEmail}</a>
        <p class="text-[11px] text-white/30">© {new Date().getFullYear()} {siteConfig.brand}. Built with Astro.</p>
      </div>
    </div>
  </div>
</footer>
