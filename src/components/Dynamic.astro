---
import TimelineCard from "./TimelineCard.astro";
import Icon from "./Icon.astro";
import { siteConfig } from "../config/site";
import { parseRss, type FeedEntry } from "../lib/rss";

const fallbackEntries: FeedEntry[] = [
  {
    date: "2026.05.14",
    title: "Spring AI 模块化 RAG 实战：从手动检索到 Advisor 管道的演进之路",
    excerpt: "记录 IntelliRAG 项目从手动构建 RAG 流程到全面采用 Spring AI 模块化 Advisor 架构的演进过程。",
    tag: "AI",
    href: "https://blog.tooonran.top/2026/05/14/Spring%20AI%20%E6%A8%A1%E5%9D%97%E5%8C%96%20RAG%20%E5%AE%9E%E6%88%98%EF%BC%9A%E4%BB%8E%E6%89%8B%E5%8A%A8%E6%A3%80%E7%B4%A2%E5%88%B0%20Advisor%20%E7%AE%A1%E9%81%93%E7%9A%84%E6%BC%94%E8%BF%9B%E4%B9%8B%E8%B7%AF/",
  },
  {
    date: "2026.05.08",
    title: "事件驱动的 ASR → LLM → ES 回写：设计拆解与实践",
    excerpt: "分析如何把语音转写、大模型分析和搜索索引通过事件驱动的方式解耦并可靠地同步回写。",
    tag: "架构设计",
    href: "https://blog.tooonran.top/2026/05/08/%E4%BA%8B%E4%BB%B6%E9%A9%B1%E5%8A%A8%E7%9A%84%20ASR%20%E2%86%92%20LLM%20%E2%86%92%20ES%20%E5%9B%9E%E5%86%99%EF%BC%9A%E8%AE%BE%E8%AE%A1%E6%8B%86%E8%A7%A3%E4%B8%8E%E5%AE%9E%E8%B7%B5/",
  },
  {
    date: "2026.05.08",
    title: "从 ASR 结果到可用输入：清洗、归一化与扩展点设计",
    excerpt: "探讨如何将原始 ASR 转写结果转化为下游大模型可以直接消费的标准输入。",
    tag: "ASR",
    href: "https://blog.tooonran.top/2026/05/08/%E4%BB%8E%20ASR%20%E7%BB%93%E6%9E%9C%E5%88%B0%E5%8F%AF%E7%94%A8%E8%BE%93%E5%85%A5%EF%BC%9A%E6%B8%85%E6%B4%97%E3%80%81%E5%BD%92%E4%B8%80%E5%8C%96%E4%B8%8E%E6%89%A9%E5%B1%95%E7%82%B9%E8%AE%BE%E8%AE%A1/",
  },
];

let entries = fallbackEntries;
try {
  const response = await fetch(siteConfig.rssUrl);
  if (response.ok) {
    const liveEntries = parseRss(await response.text(), 3);
    if (liveEntries.length === 3) entries = liveEntries;
  }
} catch {
  // Keep the verified fallback entries when RSS is temporarily unavailable.
}
---

<section id="dynamic" data-section data-nav-tone="light" class="scroll-mt-0 bg-[#fafbf9] py-20 sm:py-28">
  <div class="section-shell">
    <div class="reveal flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
      <div>
        <p class="section-kicker text-sea">Latest traces / 动态</p>
        <h2 class="section-title">最近留下的<br />几条轨迹。</h2>
      </div>
      <a href={siteConfig.blogUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold underline decoration-sea decoration-2 underline-offset-8">
        查看全部文章 <Icon name="arrow-up-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="reveal mt-16 border-b border-ink/15">
      {entries.map((entry) => <TimelineCard {...entry} />)}
    </div>
  </div>
</section>
