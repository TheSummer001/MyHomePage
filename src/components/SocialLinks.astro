---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config/site";
---

<div class="flex flex-wrap gap-3">
  {siteConfig.socials.map((social) => (
    <a
      href={social.href}
      target={social.href.startsWith("http") ? "_blank" : undefined}
      rel={social.href.startsWith("http") ? "noreferrer" : undefined}
      class="group flex h-11 items-center gap-2.5 rounded-full border border-ink/15 px-4 text-xs font-semibold transition-all hover:-translate-y-0.5 hover:border-signal hover:text-signal"
      aria-label={social.label}
    >
      <Icon name={social.icon} class="h-4 w-4" style={`color: ${social.color}`} aria-hidden="true" />
      {social.label}
    </a>
  ))}
</div>
